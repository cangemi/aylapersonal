POSTGRES_PASSWORD=troque-esta-senha
RABBITMQ_PASSWORD=troque-esta-senha
# Gere uma chave aleatória local, compartilhada apenas entre Java e Hermes.
HERMES_API_SERVER_KEY=troque-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_TIMEOUT_SECONDS=180
HERMES_DASHBOARD_USERNAME=ayla
HERMES_DASHBOARD_PASSWORD=troque-por-uma-senha-para-o-painel
HERMES_DASHBOARD_SECRET=troque-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
AYLA_CHAT_OWNER_ID=local-owner
# Chave local de pelo menos 32 caracteres, para criar o primeiro login uma única vez.
AYLA_AUTH_SETUP_KEY=
AYLA_JAVA_BASE_URL=http://host.docker.internal:8080
AYLA_FINANCE_BRIDGE_KEY=troque-por-outra-chave-aleatoria-com-ao-menos-32-caracteres

# WhatsApp Java <-> agentNode (não enviar essas chaves ao frontend)
AYLA_WHATSAPP_API_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# 32 bytes aleatórios codificados em base64; preserve esta chave para restaurar backups.
WHATSAPP_SESSION_KEY=gere-32-bytes-aleatorios-em-base64
WHATSAPP_BASE_URL=http://127.0.0.1:4000
# Execução local opcional do Node; no Compose os valores são definidos pelo serviço.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=ayla
# DB_USER=ayla
# WHATSAPP_JAVA_BASE_URL=http://127.0.0.1:8080
# Opcional: substitua a detecção automática do IP da interface de saída.
# O certificado HTTPS local precisa incluir este IP nos nomes alternativos (SAN).
# AYLA_WEB_BASE_URL=https://192.168.1.50
# Transcrição local e limpeza de mídia pelo painel Hermes
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# Opcional: pronúncias somente no áudio, no formato Nome=pronúncia;Outro=pronúncia
AYLA_VOICE_PRONUNCIATIONS=

# VPS ARM64: compose.yaml + compose.vps.yaml + compose.observability.yaml
# Oracle 2 OCPUs / 12 GB: acrescente compose.oracle-free.yaml por último. Veja ORACLE_FREE.md.
COMPOSE_PROJECT_NAME=ayla
# Imagens publicadas pelo GitHub Actions: latest ou sha-<SHA completo do commit>.
AYLA_IMAGE_TAG=latest
# IP público para o certificado local; use certificado confiável para acesso público definitivo.
AYLA_PUBLIC_IP=
GRAFANA_ADMIN_USER=superadmin
GRAFANA_ADMIN_PASSWORD=
# URL aberta pelo navegador do administrador; o padrão usa túnel SSH.
GRAFANA_BROWSER_URL=http://localhost:3300/d/ayla-vps
DB_POOL_SIZE=12
MAX_CONCURRENT_CHATS=3
TRACE_SAMPLING_PROBABILITY=0.1
# Somente para coleta da API Java executada no host (observability-local).
AYLA_METRICS_SCRAPE_KEY=

# Google Calendar (optional). See AGENDA.md. Base64 encryption key must contain 32 random bytes.
AYLA_GOOGLE_CLIENT_ID=
AYLA_GOOGLE_CLIENT_SECRET=
AYLA_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/calendar/google/callback
AYLA_CALENDAR_ENCRYPTION_KEY=
