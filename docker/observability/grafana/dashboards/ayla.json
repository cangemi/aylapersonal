    {
      "id": 41,
      "type": "row",
      "title": "Uso de recursos da API Java",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 42,
      "type": "gauge",
      "title": "CPU da API por réplica",
      "description": "Uso recente de CPU do processo Java, normalizado pela JVM/sistema operacional. Consulte os gráficos de CPU da VPS e dos containers para o consumo dessas outras camadas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(process_cpu_usage{job=\"ayla-api\"} * 100) and on(instance) (up{job=\"ayla-api\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "Sem coleta",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 43,
      "type": "stat",
      "title": "Memória JVM da API por réplica",
      "description": "Memória em uso na JVM: heap + não heap. Não equivale ao RSS do processo nem à memória total do container; pilhas de threads e algumas alocações nativas ficam fora deste contador. Valor absoluto em bytes, sem limite percentual artificial.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(jvm_memory_used_bytes{job=\"ayla-api\"}) and on(instance) (up{job=\"ayla-api\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "decimals": 1,
          "noValue": "Sem coleta",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 44,
      "type": "gauge",
      "title": "Heap da API ocupado (%)",
      "description": "Heap usado dividido pelo máximo de heap informado pela JVM, por réplica. Não é percentual da RAM da VPS nem do limite total do container.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum by(instance)(jvm_memory_used_bytes{job=\"ayla-api\",area=\"heap\"}) / sum by(instance)(jvm_memory_max_bytes{job=\"ayla-api\",area=\"heap\"} > 0)) and on(instance) (up{job=\"ayla-api\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "Sem coleta",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
