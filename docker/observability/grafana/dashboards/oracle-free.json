        "multi": false,
        "includeAll": false,
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "O que é uso e o que é franquia",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "options": {
        "mode": "markdown",
        "content": "**CPU/RAM abaixo são medições do host selecionado. A franquia da Oracle considera recursos provisionados por hora, e não a porcentagem utilizada.**\n\nReferência A1 Always Free: **2 OCPUs, 12 GB, 1.500 OCPU·h e 9.000 GB·h por mês**, compartilhados entre as VMs da conta. **Não há uma cota diária oficial**; o orçamento diário divide a franquia pelos dias deste mês.\n\nOs cartões de franquia são **planejamento de uma única VM ligada 24h/dia desde o início do dia/mês**, com a alocação configurada. Não consultam a fatura OCI, não detectam mudanças anteriores de tamanho nem descontam outras VMs. Confirme o consumo oficial no painel Oracle. No computador local, as medições são da VM do Docker Desktop, não da VPS Oracle.\n\n[Documentação Oracle](https://docs.oracle.com/en-us/iaas/Content/FreeTier/freetier_topic-Always_Free_Resources.htm) · [Painel completo da Ayla](/d/ayla-vps)"
      }
    },
    {
      "id": 2,
      "title": "Origem dos dados de referência",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 3
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max(ayla_oracle_environment_info{environment=\"local\"}) or (max(ayla_oracle_environment_info{environment=\"vps\"}) * 0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "noValue": "Sem coleta",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "VPS — planejamento A1 configurado",
                  "color": "green"
                },
                "1": {
                  "text": "LOCAL — simulação; métricas do Docker Desktop",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "CPU do host agora (%)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 5
      },
      "description": "CPU não ociosa do host; não representa horas faturadas.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"vps\",instance=\"$host\",mode=\"idle\"}[5m])))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "Sem coleta",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "RAM do host agora (%)",
      "type": "gauge",
