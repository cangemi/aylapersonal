          "refId": "A",
          "expr": "100 * (node_memory_MemTotal_bytes{job=\"vps\",instance=\"$host\"} - node_memory_MemAvailable_bytes{job=\"vps\",instance=\"$host\"}) / node_memory_MemTotal_bytes{job=\"vps\",instance=\"$host\"}",
