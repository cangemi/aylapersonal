    {
      "id": 7,
      "title": "CPU em uso e capacidade de referência",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "description": "Compare a atividade medida com a alocação configurada. Em ambiente local, o host pode ter mais CPUs que a referência A1.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1 - rate(node_cpu_seconds_total{job=\"vps\",instance=\"$host\",mode=\"idle\"}[5m]))",
          "legendFormat": "CPU não ociosa (cores)",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(ayla_oracle_allocated{resource=\"cpu\"})",
          "legendFormat": "OCPUs configuradas da VM",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "Sem coleta",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "auto",
            "pointSize": 3,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
